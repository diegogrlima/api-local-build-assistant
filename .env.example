NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# Origens permitidas pelo CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Em produção, defina o domínio do frontend e TRUST_PROXY=true se estiver atrás de proxy
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RECOMMENDATION_RATE_LIMIT_MAX=8
CATALOG_REFRESH_INTERVAL_MS=3600000
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Chave de desenvolvimento em https://developer.riotgames.com: expira a cada 24h (chave de produção ainda não solicitada). Sem ela, a recomendação não usa dados de alto elo)
RIOT_API_KEY=
RIOT_PLATFORM=br1
HIGH_ELO_REFRESH_INTERVAL_MS=1800000
HIGH_ELO_DATA_FILE=data/high-elo-matches.json
