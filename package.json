{
  "name": "api-lol-build-assistant",
  "version": "0.1.0",
  "description": "API backend do assistente de builds de LoL",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "snapshot:champions": "tsx scripts/generate-champions-snapshot.ts",
    "prepare": "husky",
    "snapshot:items": "tsx scripts/generate-items-snapshot.ts"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.7",
    "fastify": "^5.12.7",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
